# Server Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/oasis_pizza

# JSON Web Token Secret
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Razorpay Test Mode Credentials (Get from dashboard.razorpay.com in Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# SMTP Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Oasis Pizza <no-reply@oasispizza.com>
ADMIN_ALERT_EMAIL=admin@oasispizza.com

# Inventory Cron Schedule (Standard 5-field cron expression)
# Default: checks every 30 minutes. Use */5 * * * * for every 5 mins during testing
INVENTORY_CRON_SCHEDULE=*/30 * * * *
